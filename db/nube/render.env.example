# Copiar como db/nube/render.env (NO se versiona: está en .gitignore) y completar.
# Las contraseñas de las tres cuentas se generan al azar, por ejemplo:
#   openssl rand -base64 24 | tr -d '/+='
# y son distintas entre sí y de la del administrador.

# Host EXTERNO de la base (Render > bodegas-db > Connections > External Database URL:
# es lo que va entre la "@" y ":5432").
DB_HOST=dpg-XXXXXXXX-a.virginia-postgres.render.com
DB_PORT=5432
POSTGRES_DB=bodegas

# Administrador que creó Render (Connections > Username / Password). Sólo bootstrap.
RENDER_ADMIN_USER=bodegas_admin
RENDER_ADMIN_PASSWORD=

# Nuestras cuentas (mismos nombres que en local).
DB_OWNER_USER=bodegas_owner
DB_OWNER_PASSWORD=
DB_APP_USER=bodegas_api
DB_APP_PASSWORD=
DB_REPORT_USER=bodegas_reportes
DB_REPORT_PASSWORD=

# Carga: misma semilla y fecha que en local. ESCALA reducida por plazo (docs/nube.md, R9).
SEMILLA=20260427
FECHA_REFERENCIA=2026-10-27
ESCALA=0.1
