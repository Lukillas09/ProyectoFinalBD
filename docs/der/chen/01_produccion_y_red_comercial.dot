graph DER {
  graph [layout=neato, overlap=false, sep="+10", splines=true, esep="+6",
         fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Producción de uva y red comercial", pad=0.4];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.08,0.04"];
  edge [fontname="DejaVu Sans", fontsize=10, len=1.3];
  "Departamento" [shape=box, label="Departamento", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
