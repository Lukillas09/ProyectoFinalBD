graph DER {
  graph [layout=neato, overlap=false, sep="+10", splines=true, esep="+6",
         fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Clientes y ventas", pad=0.4];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.08,0.04"];
  edge [fontname="DejaVu Sans", fontsize=10, len=1.3];
  "Cliente" [shape=box, label="Cliente", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Cliente__id_cliente" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<<U>id_cliente</U>>];
  "Cliente" -- "Cliente__id_cliente" [color=black, len=0.9];
  "Cliente__nombre_razon_social" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<nombre_razon_social>];
  "Cliente" -- "Cliente__nombre_razon_social" [color=black, len=0.9];
  "Cliente__documento" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<documento>];
  "Cliente" -- "Cliente__documento" [color=black, len=0.9];
  "Cliente__documento__tipo_documento" [shape=ellipse, label="tipo_documento"];
  "Cliente__documento" -- "Cliente__documento__tipo_documento" [len=0.8];
  "Cliente__documento__nro_documento" [shape=ellipse, label="nro_documento"];
  "Cliente__documento" -- "Cliente__documento__nro_documento" [len=0.8];
  "Cliente__direccion" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<direccion>];
  "Cliente" -- "Cliente__direccion" [color=black, len=0.9];
  "Cliente__fecha_alta" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<fecha_alta>];
  "Cliente" -- "Cliente__fecha_alta" [color=black, len=0.9];
  "Cliente__tipo" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<tipo<BR/><FONT POINT-SIZE="8">discriminador</FONT>>];
  "Cliente" -- "Cliente__tipo" [color=black, len=0.9];
  "Cliente__descuento_excepcion" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<descuento_excepcion>];
  "Cliente" -- "Cliente__descuento_excepcion" [color=black, len=0.9];
  "Cliente__descuento" [shape=ellipse, style="dashed", color=black, fontcolor=black, label=<descuento>];
  "Cliente" -- "Cliente__descuento" [color=black, len=0.9];
  "Socio del club" [shape=box, label="Socio del club", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Distribuidor" [shape=box, label="Distribuidor", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Distribuidor__zona_cobertura" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<zona_cobertura>];
  "Distribuidor" -- "Distribuidor__zona_cobertura" [color=black, len=0.9];
  "Distribuidor__nro_habilitacion" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<nro_habilitacion>];
  "Distribuidor" -- "Distribuidor__nro_habilitacion" [color=black, len=0.9];
  "Exportador" [shape=box, label="Exportador", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Exportador__pais_destino_principal" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<pais_destino_principal>];
  "Exportador" -- "Exportador__pais_destino_principal" [color=black, len=0.9];
  "Permiso de exportación" [shape=box, label="Permiso de exportación", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Permiso de exportación__codigo_permiso" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<<U>codigo_permiso</U>>];
  "Permiso de exportación" -- "Permiso de exportación__codigo_permiso" [color=black, len=0.9];
  "Permiso de exportación__fecha_emision" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<fecha_emision>];
  "Permiso de exportación" -- "Permiso de exportación__fecha_emision" [color=black, len=0.9];
  "Permiso de exportación__fecha_vencimiento" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<fecha_vencimiento>];
  "Permiso de exportación" -- "Permiso de exportación__fecha_vencimiento" [color=black, len=0.9];
  "Comprobante" [shape=box, label="Comprobante", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Comprobante__nro_comprobante" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<<U>nro_comprobante</U>>];
  "Comprobante" -- "Comprobante__nro_comprobante" [color=black, len=0.9];
  "Comprobante__fecha" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<fecha>];
  "Comprobante" -- "Comprobante__fecha" [color=black, len=0.9];
  "Comprobante__subtotal" [shape=ellipse, style="dashed", color=black, fontcolor=black, label=<subtotal>];
  "Comprobante" -- "Comprobante__subtotal" [color=black, len=0.9];
  "Comprobante__descuento" [shape=ellipse, style="dashed", color=black, fontcolor=black, label=<descuento>];
  "Comprobante" -- "Comprobante__descuento" [color=black, len=0.9];
  "Comprobante__total" [shape=ellipse, style="dashed", color=black, fontcolor=black, label=<total>];
  "Comprobante" -- "Comprobante__total" [color=black, len=0.9];
  "Localidad" [shape=box, label="Localidad", fontsize=13, style=filled, fillcolor="#eeeeee", color=gray55, fontcolor=gray35];
  "Localidad__id_localidad" [shape=ellipse, style="solid", color=gray55, fontcolor=gray55, label=<<U>id_localidad</U>>];
  "Localidad" -- "Localidad__id_localidad" [color=gray55, len=0.9];
  "Sala de venta" [shape=box, label="Sala de venta", fontsize=13, style=filled, fillcolor="#eeeeee", color=gray55, fontcolor=gray35];
  "Sala de venta__id_sala" [shape=ellipse, style="solid", color=gray55, fontcolor=gray55, label=<<U>id_sala</U>>];
  "Sala de venta" -- "Sala de venta__id_sala" [color=gray55, len=0.9];
  "Vino" [shape=box, label="Vino", fontsize=13, style=filled, fillcolor="#eeeeee", color=gray55, fontcolor=gray35];
  "Vino__cod_vino" [shape=ellipse, style="solid", color=gray55, fontcolor=gray55, label=<<U>cod_vino</U>>];
  "Vino" -- "Vino__cod_vino" [color=gray55, len=0.9];
  "rel__reside en__Cliente__Localidad" [shape=diamond, style=filled, fillcolor="#fbeccf", label="reside en", fontsize=10, margin="0.02,0.02"];
  "Cliente" -- "rel__reside en__Cliente__Localidad" [taillabel=<<B>(1,1)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "Localidad" -- "rel__reside en__Cliente__Localidad" [taillabel=<<B>(0,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "rel__posee__Exportador__Permiso de exportación" [shape=diamond, style=filled, fillcolor="#fbeccf", label="posee", fontsize=10, margin="0.02,0.02"];
  "Exportador" -- "rel__posee__Exportador__Permiso de exportación" [taillabel=<<B>(0,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "Permiso de exportación" -- "rel__posee__Exportador__Permiso de exportación" [taillabel=<<B>(1,1)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "rel__realiza__Cliente__Comprobante" [shape=diamond, style=filled, fillcolor="#fbeccf", label="realiza", fontsize=10, margin="0.02,0.02"];
  "Cliente" -- "rel__realiza__Cliente__Comprobante" [taillabel=<<B>(0,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "Comprobante" -- "rel__realiza__Cliente__Comprobante" [taillabel=<<B>(1,1)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "rel__se emite en__Comprobante__Sala de venta" [shape=diamond, style=filled, fillcolor="#fbeccf", label="se emite en", fontsize=10, margin="0.02,0.02"];
  "Comprobante" -- "rel__se emite en__Comprobante__Sala de venta" [taillabel=<<B>(1,1)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "Sala de venta" -- "rel__se emite en__Comprobante__Sala de venta" [taillabel=<<B>(0,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "rel__incluye__Comprobante__Vino" [shape=diamond, style=filled, fillcolor="#fbeccf", label="incluye", fontsize=10, margin="0.02,0.02"];
  "Comprobante" -- "rel__incluye__Comprobante__Vino" [taillabel=<<B>(1,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "Vino" -- "rel__incluye__Comprobante__Vino" [taillabel=<<B>(0,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "rel incluye Comprobante-Vino__cantidad" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<cantidad>];
  "rel__incluye__Comprobante__Vino" -- "rel incluye Comprobante-Vino__cantidad" [color=black, len=0.9];
  "rel incluye Comprobante-Vino__precio_unitario" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<precio_unitario>];
  "rel__incluye__Comprobante__Vino" -- "rel incluye Comprobante-Vino__precio_unitario" [color=black, len=0.9];
  "rel incluye Comprobante-Vino__descuento_porcentaje" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<descuento_porcentaje>];
  "rel__incluye__Comprobante__Vino" -- "rel incluye Comprobante-Vino__descuento_porcentaje" [color=black, len=0.9];
  "rel incluye Comprobante-Vino__subtotal" [shape=ellipse, style="dashed", color=black, fontcolor=black, label=<subtotal>];
  "rel__incluye__Comprobante__Vino" -- "rel incluye Comprobante-Vino__subtotal" [color=black, len=0.9];
  "isa__Cliente" [shape=triangle, style=filled, fillcolor="#e3f1df", label=<ES UN<BR/><FONT POINT-SIZE="8">total, exclusiva</FONT>>, fontsize=10];
  "Cliente" -- "isa__Cliente" [color="black:invis:black", len=1.0];
  "isa__Cliente" -- "Socio del club" [len=1.2];
  "isa__Cliente" -- "Distribuidor" [len=1.2];
  "isa__Cliente" -- "Exportador" [len=1.2];
}
