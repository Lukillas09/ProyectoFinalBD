graph DER {
  graph [layout=neato, overlap=false, sep="+10", splines=true, esep="+6",
         fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Vinos, composición, maridajes y auditoría", pad=0.4];
  node [fontname="DejaVu Sans", fontsize=11, margin="0.08,0.04"];
  edge [fontname="DejaVu Sans", fontsize=10, len=1.3];
  "Bodega" [shape=box, label="Bodega", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Bodega__cuit" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<<U>cuit</U>>];
  "Bodega" -- "Bodega__cuit" [color=black, len=0.9];
  "Bodega__razon_social" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<razon_social>];
  "Bodega" -- "Bodega__razon_social" [color=black, len=0.9];
  "Bodega__domicilio" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<domicilio>];
  "Bodega" -- "Bodega__domicilio" [color=black, len=0.9];
  "Vino" [shape=box, label="Vino", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Vino__cod_vino" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<<U>cod_vino</U>>];
  "Vino" -- "Vino__cod_vino" [color=black, len=0.9];
  "Vino__nombre" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<nombre>];
  "Vino" -- "Vino__nombre" [color=black, len=0.9];
  "Vino__tipo" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<tipo>];
  "Vino" -- "Vino__tipo" [color=black, len=0.9];
  "Vino__anada" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<anada>];
  "Vino" -- "Vino__anada" [color=black, len=0.9];
  "Vino__volumen_ml" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<volumen_ml>];
  "Vino" -- "Vino__volumen_ml" [color=black, len=0.9];
  "Vino__graduacion" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<graduacion>];
  "Vino" -- "Vino__graduacion" [color=black, len=0.9];
  "Vino__precio" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<precio>];
  "Vino" -- "Vino__precio" [color=black, len=0.9];
  "Vino__stock_deposito" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<stock_deposito<BR/><FONT POINT-SIZE="8">depósito único</FONT>>];
  "Vino" -- "Vino__stock_deposito" [color=black, len=0.9];
  "Cepa" [shape=box, label="Cepa", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Cepa__id_cepa" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<<U>id_cepa</U>>];
  "Cepa" -- "Cepa__id_cepa" [color=black, len=0.9];
  "Cepa__nombre" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<nombre>];
  "Cepa" -- "Cepa__nombre" [color=black, len=0.9];
  "Cepa__tipo" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<tipo>];
  "Cepa" -- "Cepa__tipo" [color=black, len=0.9];
  "Maridaje" [shape=box, label="Maridaje", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Maridaje__id_maridaje" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<<U>id_maridaje</U>>];
  "Maridaje" -- "Maridaje__id_maridaje" [color=black, len=0.9];
  "Maridaje__nombre" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<nombre>];
  "Maridaje" -- "Maridaje__nombre" [color=black, len=0.9];
  "Maridaje__temperatura_servicio_c" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<temperatura_servicio_c>];
  "Maridaje" -- "Maridaje__temperatura_servicio_c" [color=black, len=0.9];
  "Auditoría de precio" [shape=box, label="Auditoría de precio", fontsize=13, style=filled, fillcolor="#dde6f7", penwidth=1.6];
  "Auditoría de precio__id_auditoria" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<<U>id_auditoria</U>>];
  "Auditoría de precio" -- "Auditoría de precio__id_auditoria" [color=black, len=0.9];
  "Auditoría de precio__precio_anterior" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<precio_anterior>];
  "Auditoría de precio" -- "Auditoría de precio__precio_anterior" [color=black, len=0.9];
  "Auditoría de precio__precio_nuevo" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<precio_nuevo>];
  "Auditoría de precio" -- "Auditoría de precio__precio_nuevo" [color=black, len=0.9];
  "Auditoría de precio__fecha_hora" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<fecha_hora>];
  "Auditoría de precio" -- "Auditoría de precio__fecha_hora" [color=black, len=0.9];
  "Auditoría de precio__usuario_bd" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<usuario_bd>];
  "Auditoría de precio" -- "Auditoría de precio__usuario_bd" [color=black, len=0.9];
  "rel__elabora__Bodega__Vino" [shape=diamond, style=filled, fillcolor="#fbeccf", label="elabora", fontsize=10, margin="0.02,0.02"];
  "Bodega" -- "rel__elabora__Bodega__Vino" [taillabel=<<B>(1,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "Vino" -- "rel__elabora__Bodega__Vino" [taillabel=<<B>(1,1)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "rel__se compone de__Vino__Cepa" [shape=diamond, style=filled, fillcolor="#fbeccf", label="se compone de", fontsize=10, margin="0.02,0.02"];
  "Vino" -- "rel__se compone de__Vino__Cepa" [taillabel=<<B>(1,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "Cepa" -- "rel__se compone de__Vino__Cepa" [taillabel=<<B>(0,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "rel se compone de Vino-Cepa__porcentaje" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<porcentaje>];
  "rel__se compone de__Vino__Cepa" -- "rel se compone de Vino-Cepa__porcentaje" [color=black, len=0.9];
  "rel__marida con__Vino__Maridaje" [shape=diamond, style=filled, fillcolor="#fbeccf", label="marida con", fontsize=10, margin="0.02,0.02"];
  "Vino" -- "rel__marida con__Vino__Maridaje" [taillabel=<<B>(1,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "Maridaje" -- "rel__marida con__Vino__Maridaje" [taillabel=<<B>(0,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "rel__registra__Vino__Auditoría de precio" [shape=diamond, style=filled, fillcolor="#fbeccf", label="registra", fontsize=10, margin="0.02,0.02"];
  "Vino" -- "rel__registra__Vino__Auditoría de precio" [taillabel=<<B>(0,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
  "Auditoría de precio" -- "rel__registra__Vino__Auditoría de precio" [taillabel=<<B>(1,1)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
}
