  "rel transfiere Transferencia-Vino__cantidad" [shape=ellipse, style="solid", color=black, fontcolor=black, label=<cantidad>];
  "rel__transfiere__Transferencia__Vino" -- "rel transfiere Transferencia-Vino__cantidad" [color=black, len=0.9];
  "rel__tiene en stock__Sala de venta__Vino" [shape=diamond, style=filled, fillcolor="#fbeccf", label="tiene en stock", fontsize=10, margin="0.02,0.02"];
  "Sala de venta" -- "rel__tiene en stock__Sala de venta__Vino" [taillabel=<<B>(0,N)</B>>, labeldistance=2.2, labelangle=25, labelfontsize=12, labelfontcolor="#8b1a1a", color=black, len=1.6];
