# Copiar este archivo como .env y reemplazar todas las claves antes de iniciar.
# Estos valores son ejemplos locales; no son secretos reales.

POSTGRES_DB=bodegas_atuel
POSTGRES_BOOTSTRAP_USER=postgres_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=reemplazar_clave_bootstrap

DB_OWNER_USER=bodegas_owner
DB_OWNER_PASSWORD=reemplazar_clave_propietario

DB_APP_USER=bodegas_api
DB_APP_PASSWORD=reemplazar_clave_api

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=2
DB_CONNECT_TIMEOUT_SECONDS=3

API_PORT=8000
FRONT_PORT=8080
